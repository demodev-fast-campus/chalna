# Chalna production environment variables
# Copy this file to .env locally, or set the same keys in your hosting platform.

NODE_ENV=production
PORT=3000

# MySQL-compatible database used by Drizzle.
# Example: mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# Session signing secret. Use a long random value in production.
JWT_SECRET=

# Manus OAuth / app identity.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Manus/WebDev built-in storage API used for video uploads and playback.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
